node_modules/
dist/
target/
**/target/
.cargo-target/
**/.cargo-target/
.git/
.claude/
.vscode/
*.log
deploy/
# keep the self-host all-in-one build context (Dockerfile COPYs from here)
!deploy/self-host/all-in-one/
!deploy/self-host/all-in-one/**
*.md
# Root-context builds (deploy/self-host/amuxd/Dockerfile) compile the Cargo
# workspace, so every workspace member's manifest has to stay in context. The
# non-Rust clients are dead weight there.
apps/ios/
apps/expo/
apps/extension/
packages/app/
# ...except the bundled skill files amuxd compiles in with include_str!
# (apps/daemon/src/runtime/supervisor.rs). Excluding them broke the daemon
# image build.
!packages/app/src/lib/skills/*/SKILL.md
