+                if (it == unique.end()) {
+                    unique.push_back(rec);
+                } else if (rec.rssi > it->rssi) {
+                    *it = rec;  // same name, better signal — prefer this BSSID
+                }
+            }
+            std::sort(unique.begin(), unique.end(),
+                      [](const wifi_ap_record_t &a, const wifi_ap_record_t &b) {
+                          return a.rssi > b.rssi;
+                      });
+            self->ap_records_.swap(unique);
+        }
+
         // 扫描完成，等待10秒后再次扫描
         esp_timer_start_once(self->scan_timer_, 10 * 1000000);
     }
