{
  "expo": {
    "name": "TeamClu Expo",
    "slug": "teamclu-expo",
    "scheme": "teamclu",
    "version": "0.1.0",
    "orientation": "portrait",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.teamclu",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "./plugins/withTeamCluMqtt",
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TeamClu uses the microphone to turn what you say into a message.",
          "speechRecognitionPermission": "TeamClu uses speech recognition to turn what you say into a message."
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-router",
      "expo-sqlite",
      [
        "@sentry/react-native",
        {
          "organization": "ucar-inc",
          "project": "teamclu-expo"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.teamclu",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "zh-Hans"]
      }
    },
    "extra": {
      "eas": {
        "projectId": "ddfbf2cd-4440-4c7a-b1fb-f773687cc060"
      }
    },
    "owner": "teamklo-team"
  }
}
