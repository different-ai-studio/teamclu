# Cloud API to run against (default: the self-host test box).
CLOUD_API_URL=https://api.teamclu-dev.ucar.cc
# Optional pre-provisioned owner (password sign-in). Unset ⇒ each scenario signs
# up a throwaway owner, which needs ENABLE_EMAIL_AUTOCONFIRM=true on the target.
OSS_E2E_OWNER_EMAIL=
OSS_E2E_OWNER_PASSWORD=
# Set to 1 to run the optional scenarios.
RUN_THREE_NODE=0
RUN_HEAVY=0
# No host ports: each scenario gets its own compose project and an ephemeral
# port (container 8787), discovered with `docker compose port`.
