{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is currently responding. Stopping will interrupt the reply mid-stream.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在回复中。停止会中断当前回复。"
          }
        }
      }
    },
    "%@ has nothing installed from the team catalog yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 还没有从团队目录安装任何内容。"
