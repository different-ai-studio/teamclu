{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for app-origin surfaces only. Every webview listed here loads TeamClu's own frontend (WebviewUrl::App): `main`, the per-workspace `ws-*` windows (index.html?workspace=), and `local-agent-panel`. Third-party content — the in-app browser's `wv-*` webviews and the `websso-login` webview, both built from a caller-supplied URL as WebviewUrl::External — is deliberately absent, so an arbitrary page cannot reach a single IPC command. Do NOT add a `remote` block here. `remote.urls` is the only thing that lets a non-app origin use these permissions, and it is what actually keeps `wv-*` out: RuntimeAuthority::resolve_access allows a command when the webview OR the window label matches, and `wv-*` webviews are children of window `main` — so dropping them from `webviews` alone would not have been enough. The fs grants below are NOT whole-disk any more (SEC-2 / ADR-0009): statically they cover only the two fixed skill roots. Everything else is granted at runtime -- the brand's amuxd home and each workspace as it is opened, by src/fs_scope.rs; dialog picks and OS drag-drop, by Tauri itself. Runtime grants do not survive a restart, so anything needed on a cold start belongs in fs_scope::fixed_roots or here.",
  "windows": ["main", "ws-*", "local-agent-panel"],
  "webviews": ["main", "ws-*", "local-agent-panel"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "notification:default",
    "clipboard:allow-has-files",
    "clipboard:allow-read-files",
    "clipboard:allow-write-files",
    "notification:allow-show",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "$HOME/.agents/**" },
        { "path": "$HOME/.claude/skills/**" }
      ]
    },
    "fs:default",
    "updater:default",
    "core:webview:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-focused",
    "core:window:allow-is-visible",
    "process:allow-restart",
    "aptabase:allow-track-event",
    "log:default",
    "window-state:default",
    "mcp:default",
    "deep-link:default"
  ]
}
