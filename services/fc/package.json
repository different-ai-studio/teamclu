    "@alicloud/openapi-client": "^0.4.12",
    "@alicloud/sls20201230": "^5.12.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@hono/node-server": "^2.1.11",
    "@supabase/supabase-js": "^2.119.2",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "mqtt": "^5.16.1",
    "postgres": "^3.4.9",
    "stripe": "^22.6.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@redocly/cli": "^2.82.0",
