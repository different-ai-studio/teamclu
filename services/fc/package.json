  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "openapi:lint": "redocly lint ../../docs/openapi/teamclu-api.v1.yaml",
