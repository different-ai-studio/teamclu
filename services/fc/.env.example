# teamclu-fc — environment template for Docker self-host.
# Copy to .env and fill in. The self-host Compose environment map is the
# authoritative runtime allowlist.

# --- container-specific ---
PORT=9000
HOST=0.0.0.0

# --- core ---
SUPABASE_URL=
SUPABASE_PUBLIC_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- OSS / object storage ---
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
ROLE_ARN=
# BUCKET is account-specific; do not point a test environment at another
# deployment's bucket.
BUCKET=teamclu-team
REGION=cn-shenzhen
ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com

# --- MQTT ---
# MQTT_BROKER_URL is the ONE broker address. It is how *FC itself* reaches the
# broker (the inbox publisher in push-deps.ts) AND the address
# GET /v1/config/bootstrap hands to clients. It must therefore be reachable BY
# CLIENTS — a container-internal address (`mqtt://emqx:1883`,
# `mqtt://127.0.0.1:1883`) is a misconfiguration, because it is handed straight
# out to every client.
#
# There used to be a separate MQTT_PUBLIC_BROKER_URL override in front of this.
# It is gone. Every deployment declared it with an empty default, `""` is not
# nullish, so the documented fallback to MQTT_BROKER_URL never fired and
# bootstrap answered 200 with no `mqtt` block at all — clients reported no MQTT
# address while the daemon, which never reads this endpoint, stayed connected and
# masked the outage (issue #634, and again on belayo afterwards).
#
# If this is empty the `mqtt` block is omitted entirely and real-time sync is
# off; that is still a silent 200, so check it after any deploy.
MQTT_BROKER_URL=
# Raw-TCP address for clients whose MQTT stack can't do WebSocket (iOS
# CocoaMQTT, Expo). Only needed when MQTT_BROKER_URL is a ws(s):// URL — with an
# mqtt:// broker those clients already use it directly.
MQTT_PUBLIC_TCP_BROKER_URL=
