# ── Local development preset (macOS / Podman / Docker Desktop) ───────────
#
# Quick start:
#   cd deploy/self-host
#   cp .env.local.example .env
#   ./bootstrap/gen-secrets.sh
#   ./bootstrap/up.sh
#   ./bootstrap/check.sh
#
# Uses 127.0.0.1 + host ports — do NOT add FC_DOMAIN / MQTT_DOMAIN to /etc/hosts.
# JWT_SECRET + POSTGRES_PASSWORD below are dev-only placeholders; change before
# any shared or production host.
#
# Client (Desktop): cp ../../packages/app/.env.local.example ../../packages/app/.env.local

# ── core secret (gen-secrets.sh validates length) ───────────────────────
JWT_SECRET=local-dev-jwt-secret-do-not-use-in-production-32
POSTGRES_PASSWORD=local-dev-postgres-password

# ── derived by bootstrap/gen-secrets.sh (leave blank) ──────────────────
ANON_KEY=
SERVICE_ROLE_KEY=
MQTT_SERVICE_TOKEN=
EMQX_JWT_SECRET=
CADDY_GLOBAL_TLS=
CADDY_SITE_TLS=
CADDY_SITE_SCHEME=

# ── system / docker integration ────────────────────────────────────────
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# ── domains (Caddy vhost labels + future server DNS — not /etc/hosts) ─
FC_DOMAIN=api.example.com
SUPABASE_DOMAIN=supabase.example.com
MQTT_DOMAIN=mqtt.example.com
STUDIO_DOMAIN=studio.example.com
EMQX_DASHBOARD_DOMAIN=emqx.example.com
GITEA_DOMAIN=gitea.example.com
GITEA_SSH_PORT=2222

# The one broker address — dialled by FC and delivered to clients via
# GET /v1/config/bootstrap (Desktop MQTT TCP). Must be client-reachable.
MQTT_BROKER_URL=mqtt://127.0.0.1:1883

# ── Caddy TLS (local: plain HTTP on mapped ports) ─────────────────────
# Podman rootless: bootstrap/up.sh also sets 8080/8443 when using podman-compose.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
CADDY_TLS_MODE=off
ACME_EMAIL=ops@example.com

# ── FC service ─────────────────────────────────────────────────────────
CRON_TRIGGER_SECRET=

# ── object storage (optional — leave blank to disable OSS features) ───
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
ROLE_ARN=
BUCKET=teamclu-team
REGION=cn-shenzhen
ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com

# Gitea (Apps module git). FC uses in-network API; GITEA_ROOT_URL keeps clone
# links public-facing when Caddy serves HTTP on :8080.
GITEA_URL=http://gitea:3000
GITEA_ROOT_URL=http://gitea.example.com:8080
GITEA_TOKEN=
GITEA_OWNER=teamclaw-apps
GITEA_ADMIN_USERNAME=gitea-admin
GITEA_ADMIN_PASSWORD=local-dev-gitea-admin-password
GITEA_ADMIN_EMAIL=ops@example.com
GITEA_BOT_USERNAME=teamclu-bot
GITEA_BOT_PASSWORD=local-dev-gitea-bot-password

# ── LiteLLM (optional) ─────────────────────────────────────────────────
LITELLM_URL=
LITELLM_MASTER_KEY=

# ── TeamClu daemon (optional; docker compose --profile daemon) ─────────
AMUXD_JOIN_TOKEN=
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_PROVIDER_ID=selfhost
OPENCODE_PROVIDER_NAME=Self-host LLM

# ── Supabase stack ─────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# Per-org app DBs on the same Postgres. Compose also defaults this when blank.
APPS_DB_ADMIN_URL=postgres://postgres:local-dev-postgres-password@db:5432/postgres
JWT_EXPIRY=3600
PGRST_DB_SCHEMAS=public,storage,graphql_public,amux
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
# Keep this false. Invite-only deployments are configured with the Cloud API's
# `allowNewOrg` feature flag, NOT here: an invitee has no GoTrue account yet, so
# disabling signup would stop them creating one and lock the invite flow out of
# its own product. GoTrue lets them authenticate; FC decides whether they may
# mint an organization.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Local: skip email verification (no real SMTP)
ENABLE_EMAIL_AUTOCONFIRM=true
# Anonymous / quick-trial sign-in has been removed from the product; the local
# no-SMTP path is ENABLE_EMAIL_AUTOCONFIRM above plus email OTP.
ENABLE_ANONYMOUS_USERS=false
# Override self-host profile (password:false) so /v1/config/public exposes password login.
# Durable profile still lives in services/fc/src/lib/feature-profiles.ts.
APP_FEATURES_JSON={"auth":{"password":true,"google":false},"teamShareBrowser":true}
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
FUNCTIONS_VERIFY_JWT=false
IMGPROXY_ENABLE_WEBP_DETECTION=true
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
LOGFLARE_API_KEY=your-logflare-api-key-please-change
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
# The chromiumapp.org entry is the Chrome extension's synthetic OAuth redirect
# (chrome.identity.launchWebAuthFlow); see .env.example for the full note.
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:*/callback,teamclu://auth-callback,https://nlmkpmokfbboonocdnngddbfpdedkfee.chromiumapp.org/

# Google sign-in — off unless both values are filled. The OAuth client must be
# a "Web application" client with https://<SUPABASE_DOMAIN>/auth/v1/callback as
# its Authorized redirect URI; see .env.example for why a Desktop client fails.
ENABLE_GOOGLE_SIGNUP=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in — native id_token grant only, no secret. APPLE_CLIENT_IDS is the
# comma-separated list of accepted `aud` values (the iOS bundle ID).
ENABLE_APPLE_SIGNUP=true
APPLE_CLIENT_IDS=tech.teamclaw.mobile,com.teamclu.mobile
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=fake_sender
SUPABASE_PUBLIC_URL=
API_EXTERNAL_URL=
SITE_URL=
