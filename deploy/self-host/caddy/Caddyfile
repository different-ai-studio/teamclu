{
	email {$ACME_EMAIL}
	# CADDY_GLOBAL_TLS expands to "auto_https off" when CADDY_TLS_MODE=off, empty otherwise.
	{$CADDY_GLOBAL_TLS}
	# Force RSA certs — ECDSA with Let's Encrypt YE1 chain causes
	# ERR_SSL_VERSION_OR_CIPHER_MISMATCH on some clients (incl. CN networks).
	key_type rsa2048

	# Deployed apps get a certificate on first request rather than from a fixed
	# list — there is no list, apps come and go. `ask` is what keeps that from
	# being an open cert-minting endpoint: FC answers 404 for any hostname that
	# is not a deployed app, and Caddy then declines the handshake instead of
	# going to Let's Encrypt. Without it, anyone pointing a name at this box
	# could burn the rate limit, which counts per REGISTERED domain and is
	# therefore shared with api/supabase/mqtt/s3 on the same name.
	on_demand_tls {
		ask http://fc:9000/internal/caddy/ask
	}
}

# CADDY_SITE_SCHEME is "http://" when CADDY_TLS_MODE=off (gen-secrets.sh), empty
# for acme/internal. Bare hostnames with auto_https off still bind :443 in Caddy
# 2.x unless the scheme is explicit — which breaks Podman port maps (8080→80).
{$CADDY_SITE_SCHEME}{$FC_DOMAIN} {
	{$CADDY_SITE_TLS}

	# Team AI gateway, mounted as a path on the FC domain so it needs no extra
	# DNS record. handle_path strips the /ai prefix, so
	# https://<host>/ai/v1/teams/<id>/chat/completions arrives at the service as
	# /v1/teams/<id>/chat/completions. handle_path and handle are mutually
	# exclusive, so /ai never falls through to FC.
	#
	# /llm/*, /ui/* and /litellm-asset-prefix/* used to sit here, proxying to
	# LiteLLM. LiteLLM is gone; a team whose llm_base_url still ends in /llm now
	# reaches nothing.
	handle_path /ai/* {
		reverse_proxy ai-gateway:4001
	}

	# CORS is handled entirely by FC (Hono middleware in services/fc/src/app.ts),
	# which is origin-aware (reflects the request Origin, allows tauri:// and
	# localhost, honours CORS_ORIGINS). Do NOT also set CORS headers here — Caddy
	# would emit a second Access-Control-Allow-Origin on proxied (non-OPTIONS)
	# responses, and browsers reject any response carrying more than one ACAO.
	handle {
		reverse_proxy fc:9000
	}
}

{$CADDY_SITE_SCHEME}{$SUPABASE_DOMAIN} {
	{$CADDY_SITE_TLS}
	reverse_proxy kong:8000
}

{$CADDY_SITE_SCHEME}{$MQTT_DOMAIN} {
	{$CADDY_SITE_TLS}
	# Caddy v2 reverse_proxy transparently upgrades WebSocket connections.
	reverse_proxy emqx:8083
}

# Blob storage (MinIO) for team files. The daemon transfers bytes here directly
# against a presigned URL, so this name must be the one FC signs for (ENDPOINT)
# — SigV4 covers the Host header and a mismatch fails every upload.
#
# S3_DOMAIN falls back to s3.localhost (internal CA, no ACME) on a box that has
# not enabled MinIO. It must never be empty: Caddy reads a nameless block as
# global configuration and refuses to start.
{$CADDY_SITE_SCHEME}{$S3_DOMAIN} {
	{$CADDY_SITE_TLS}
	reverse_proxy minio:9000
}

# Private image registry for container apps.
#
# The registry container has no authentication of its own, so this site is the
# whole of it. Two logins rather than one: the deployed function keeps its pull
# credential in its own configuration, where anyone who can read the function
# can read it — and a credential that can also PUSH there means replacing the
# image every instance of that app executes.
#
# The split is by method, because that is what the registry protocol makes it:
# a pull is GET/HEAD, and everything that writes a blob, a manifest or a tag is
# POST/PUT/PATCH/DELETE. Both password hashes are bcrypt, from
# `docker run --rm caddy:2 caddy hash-password --plaintext '<password>'`.
#
# REGISTRY_DOMAIN falls back to registry.localhost on a box that has not
# enabled it, for the same reason S3_DOMAIN does: Caddy reads a nameless block
# as global configuration and refuses to start.
{$CADDY_SITE_SCHEME}{$REGISTRY_DOMAIN} {
	{$CADDY_SITE_TLS}

	# An image layer is tens of megabytes and the default cap is 10MB.
	request_body {
		max_size 2GB
	}

	@write method POST PUT PATCH DELETE
	handle @write {
		basic_auth {
			{$REGISTRY_PUSH_USERNAME} {$REGISTRY_PUSH_PASSWORD_HASH}
		}
		reverse_proxy registry:5000
	}

	handle {
		basic_auth {
			{$REGISTRY_PUSH_USERNAME} {$REGISTRY_PUSH_PASSWORD_HASH}
			{$REGISTRY_PULL_USERNAME} {$REGISTRY_PULL_PASSWORD_HASH}
		}
		reverse_proxy registry:5000
	}
}

{$CADDY_SITE_SCHEME}{$STUDIO_DOMAIN} {
	{$CADDY_SITE_TLS}
	reverse_proxy studio:3000
}

{$CADDY_SITE_SCHEME}{$EMQX_DASHBOARD_DOMAIN} {
	{$CADDY_SITE_TLS}
	reverse_proxy emqx:18083
}

# Gitea — per-app private git repos (Apps module). SSH is NOT proxied here;
# clients dial GITEA_DOMAIN:GITEA_SSH_PORT directly (see docker-compose.yml).
#
# GITEA_DOMAIN falls back to gitea.localhost (internal CA, no ACME) on a box
# that has not set one, for the same reason S3_DOMAIN does: a nameless block is
# read as global configuration and Caddy refuses to start.
{$CADDY_SITE_SCHEME}{$GITEA_DOMAIN} {
	{$CADDY_SITE_TLS}
	reverse_proxy gitea:3000
}

# Central login service for deployed apps.
#
# One hostname, owned outright by FC: it renders the login page, does the email
# round trip, and holds the SSO cookie that lets a visitor open a second app
# without logging in again. Apps themselves never serve any of this — what
# crosses back to an app is a one-shot code, because a cookie set here cannot
# be read on an app's own hostname (and once custom domains exist, that is the
# normal case rather than the exception).
#
# LOGIN_DOMAIN falls back to login.localhost on a box that has not set one, for
# the same reason S3_DOMAIN does: a nameless block is read as global
# configuration and Caddy refuses to start.
{$CADDY_SITE_SCHEME}{$LOGIN_DOMAIN} {
	{$CADDY_SITE_TLS}
	reverse_proxy fc:9000
}

# Deployed apps: <slug>-<id8>.{$APPS_DOMAIN}
#
# The wildcard sits one level DOWN, on its own `apps.` label, and never on the
# bare base domain: `*.teamclu-dev.ucar.cc` would swallow api/supabase/mqtt/s3/
# studio/emqx and hand every typo'd hostname to on-demand TLS.
#
# Everything goes to FC rather than straight to Function Compute because the
# trigger hostname carries a random suffix (tc-app-<id>-<random>.fcapp.run) and
# cannot be derived from the request — FC looks the app up by Host and streams
# the response through. That also means an app's routes survive a Caddy restart
# with no reconciliation: there is nothing per-app in this file.
#
# APPS_DOMAIN falls back to apps.localhost (internal CA, no ACME) on a box that
# has not set one, for the same reason S3_DOMAIN does: a nameless block is read
# as global configuration and Caddy refuses to start.
{$CADDY_SITE_SCHEME}*.{$APPS_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy fc:9000
}

# Domains an app's owner bound themselves.
#
# MUST BE THE LAST SITE BLOCK IN THIS FILE: a bare `:443` matches every Host
# no other block claimed, so anything after it would never be reached.
#
# The address is a variable, not a literal `:443`, because with CADDY_TLS_MODE=off
# that literal binds :443 anyway — the same trap CADDY_SITE_SCHEME exists for,
# and the one that breaks a Podman port map of 8080->80. gen-secrets.sh points
# it at an http:// placeholder in that mode; custom domains need on-demand TLS,
# so they mean nothing there.
#
# The certificate is still gated by the global `on_demand_tls { ask }` above.
# FC answers 200 only for a hostname that resolves to an app — a vanity name,
# or a custom domain whose ownership has been VERIFIED — and 404 for everything
# else, at which point Caddy declines the handshake rather than asking Let's
# Encrypt for a certificate. Without that gate this block would be an open
# certificate-minting endpoint for any name pointed at this box, and the rate
# limit it would burn is per REGISTERED domain, shared with api/supabase/mqtt.
#
# Requests that reach FC on a hostname it does not recognise fall through to
# the Cloud API, which answers its own 404.
#
# This block is also the whole reason catch-all custom domains are a self-host
# feature. Belayo's user Apps still run on Alibaba Function Compute, where a
# hostname reaches a function only if a custom domain was created for it. See
# docs/specs/2026-09-08-apps-login-and-custom-domain-design.md §5.8.
{$CADDY_CATCHALL_SITE} {
	tls {
		on_demand
	}
	reverse_proxy fc:9000
}
