{
  "name": "teamclu",
  "version": "0.4.1-beta.34",
  "private": true,
  "description": "TeamClu - AI Agent Desktop Platform",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @teamclu/app dev",
    "expo:dev": "pnpm --filter @teamclu/expo dev",
    "expo:ios": "pnpm --filter @teamclu/expo ios",
    "expo:android": "pnpm --filter @teamclu/expo android",
    "expo:test": "pnpm --filter @teamclu/expo test",
    "build": "pnpm --filter @teamclu/app build",
    "preview": "pnpm --filter @teamclu/app preview",
    "tauri": "node scripts/tauri-cli.js",
    "tauri:dev": "node scripts/update-tauri-config.js && node scripts/tauri-cli.js dev",
    "tauri:dev:daemon": "node scripts/update-tauri-config.js && node scripts/tauri-cli.js dev --force-amuxd",
    "tauri:dev:introspect": "node scripts/update-tauri-config.js && node scripts/tauri-cli.js dev --force-introspect",
    "tauri:build": "node scripts/update-tauri-config.js && node scripts/tauri-cli.js build",
    "tauri:build:debug": "node scripts/update-tauri-config.js && node scripts/tauri-cli.js build --debug",
    "tauri:deeplink:clean": "node scripts/deeplink-dev.mjs clean",
    "tauri:deeplink:register": "node scripts/deeplink-dev.mjs register",
    "tauri:deeplink:open": "node scripts/deeplink-dev.mjs open",
    "tauri:deeplink:test": "node scripts/deeplink-dev.mjs test",
    "tauri:build:mac:all": "node scripts/update-tauri-config.js && sh -c 'export CMAKE_OSX_DEPLOYMENT_TARGET=10.15; echo \"🔨 Building for ARM64 (aarch64)...\"; node scripts/tauri-cli.js build --target aarch64-apple-darwin && echo \"\" && echo \"🔨 Building for Intel (x86_64)...\" && node scripts/tauri-cli.js build --target x86_64-apple-darwin && echo \"\" && echo \"✅ Dual-arch build complete\" && echo \"   ARM64: .cargo-target/aarch64-apple-darwin/release/bundle/\" && echo \"   Intel: .cargo-target/x86_64-apple-darwin/release/bundle/\"' sh",
    "tauri:build:mac:all:debug": "node scripts/update-tauri-config.js && sh -c 'export CMAKE_OSX_DEPLOYMENT_TARGET=10.15; echo \"🔨 Building DEBUG for ARM64 (aarch64)...\"; node scripts/tauri-cli.js build --debug --target aarch64-apple-darwin && echo \"\" && echo \"🔨 Building DEBUG for Intel (x86_64)...\" && node scripts/tauri-cli.js build --debug --target x86_64-apple-darwin && echo \"\" && echo \"✅ Dual-arch DEBUG build complete\" && echo \"   ARM64: .cargo-target/aarch64-apple-darwin/debug/bundle/\" && echo \"   Intel: .cargo-target/x86_64-apple-darwin/debug/bundle/\"' sh",
    "tauri:build:win": "node scripts/update-tauri-config.js && node scripts/tauri-cli.js build --bundles nsis -- --no-default-features",
    "tauri:dev:win": "node scripts/update-tauri-config.js && node scripts/tauri-cli.js dev -- --no-default-features",
    "rust:check": "node scripts/rust-cli.js check --manifest-path apps/desktop/Cargo.toml",
    "rust:build": "node scripts/rust-cli.js build --manifest-path apps/desktop/Cargo.toml",
    "rust:clippy": "node scripts/rust-cli.js clippy --manifest-path apps/desktop/Cargo.toml -- -D warnings",
    "daemon:run": "node scripts/daemon-cargo.js run",
    "daemon:deploy": "scripts/deploy-daemon-binaries.sh",
    "daemon:ctl": "scripts/amuxdctl.sh",
    "dev:daemon": "scripts/dev-daemon.sh",
    "dev:desktop": "scripts/dev-desktop.sh",
    "reset:local": "scripts/reset-local-state.sh",
    "daemon:build": "node scripts/daemon-cargo.js build",
    "daemon:test": "node scripts/daemon-cargo.js test",
    "ios:generate": "cd apps/ios && xcodegen generate",
    "ios:proto-gen": "protoc -I proto --swift_out=apps/ios/Packages/AMUXCore/Sources/AMUXCore/Proto --swift_opt=Visibility=Public proto/amux.proto proto/teamclu.proto",
    "ios:build": "xcodebuild -project apps/ios/AMUX.xcodeproj -scheme AMUX -destination 'generic/platform=iOS Simulator' -derivedDataPath apps/ios/build build",
    "ios:run": "scripts/run-ios.sh",
    "ios:test:core": "swift test --package-path apps/ios/Packages/AMUXCore",
    "ios:test": "xcodebuild test -project apps/ios/AMUX.xcodeproj -scheme AMUXUITests -destination 'platform=iOS Simulator,name=iPhone 17 Pro' -derivedDataPath apps/ios/build",
    "installer:win": "node scripts/build-windows.js",
    "lint": "pnpm --filter @teamclu/app lint",
    "typecheck": "pnpm --filter @teamclu/app typecheck",
    "test": "pnpm test:unit",
    "test:all": "pnpm test:unit && pnpm expo:test",
    "test:unit": "pnpm --filter @teamclu/app test:unit",
    "test:expo": "pnpm --filter @teamclu/expo test",
    "typecheck:expo": "pnpm --filter @teamclu/expo typecheck",
    "test:extension": "pnpm --filter @teamclu/extension test",
    "typecheck:extension": "pnpm --filter @teamclu/extension typecheck",
    "test:scripts": "node --test scripts/lib/*.test.js apps/desktop/capabilities/*.test.js",
    "test:smoke": "vitest run --config vitest.config.v2-e2e.ts tests/v2-e2e/pr",
    "test:e2e": "pnpm test:e2e:v2:pr",
    "test:e2e:v2:pr": "vitest run --config vitest.config.v2-e2e.ts tests/v2-e2e/pr",
    "test:e2e:v2:nightly": "vitest run --config vitest.config.v2-e2e.ts tests/v2-e2e/nightly",
    "test:e2e:legacy": "vitest run --config vitest.config.e2e.ts tests/e2e tests/functional tests/regression",
    "test:e2e:regression": "vitest run --config vitest.config.e2e.ts tests/regression",
    "test:e2e:performance": "vitest run --config vitest.config.e2e.ts tests/performance",
    "test:e2e:e2e": "vitest run --config vitest.config.e2e.ts tests/e2e",
    "test:e2e:functional": "vitest run --config vitest.config.e2e.ts tests/functional",
    "test:stress": "vitest run --config vitest.config.stress.ts",
    "verify-release": "./scripts/verify-release-build.sh",
    "release:check": "./scripts/check-desktop-version.sh",
    "release:bump": "node scripts/bump-desktop-version.mjs",
    "release:preflight": "./scripts/preflight-desktop-release.sh",
    "release:desktop": "./scripts/release-desktop.sh",
    "marketplace:publish": "node packages/cli/bin/teamclu.js marketplace publish",
    "cli": "node packages/cli/bin/teamclu.js",
    "ship": "./scripts/ship-pr.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "shadcn": "^4.18.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
