# Cloudflare Pages headers for teamclu.ai
#
# `_headers` is read by Pages automatically — no build step, no config. The
# gallery PNGs are content-addressed by name, not hash, so they get a short
# TTL rather than the immutable year that a hashed asset would deserve.

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
