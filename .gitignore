# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
# …except the pi-host stub SDK fixture, which host.mjs imports as <pkg>/dist/index.js
!apps/daemon/tests/fixtures/pi-host-stub/dist/
target/
.cargo-target/
.cargo-target-*/
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
# `.claude/*` not `.claude/` — git will not descend into an ignored *directory*,
# so the re-includes below would never apply and new shared skills would be
# silently dropped from commits.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/workflows/
.ai
.agent/
.cursor/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local
.env.release
config.json
build.config.local.json

services/pocketbase/pb_data/
build.config.production.json


# Tauri
apps/desktop/gen/schemas/
apps/desktop/target/
apps/desktop/binaries/*
!apps/desktop/binaries/.gitkeep
!apps/desktop/binaries/README.md
!apps/desktop/binaries/build-rag-mcp-server.sh
!apps/desktop/binaries/build-autoui-mcp-server.sh
apps/desktop/.tauri_private_key
apps/desktop/.tauri_private_key.pub

# Testing
coverage/
tests/screenshots/
apps/ios/build/
apps/ios/DerivedData/
apps/ios/**/.build/
apps/ios/**/xcuserdata/
apps/ios/**/*.xcuserstate

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.Python

# TeamClu local runtime data (all config/data stored in .teamclu/ directory)
.teamclu/

# Spec workflow config (copy from .spec.example.json)
.spec.json

# Misc
*.lock
!pnpm-lock.yaml
!/Cargo.lock
logs
playwright-report/
screenshots/
test-results/
playwright-report/

# Worktrees
.worktrees/

# Tauri MCP plugin (cloned dependency)
# Dev-only guest-JS package for tauri-mcp. Usually a symlink to
# apps/desktop/tauri-plugin-mcp-local, so match the bare name too — the
# trailing-slash form ignores a directory but not a symlink to one.
.tauri-plugin-mcp
.tauri-plugin-mcp/


# Session context (per-workspace, do not commit)
.claude/session-context/current.md

.workspace/

teamclu-team/

# Sensitive information
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# IDE settings (keep .vscode/ but not settings.json)
.vscode/settings.json

# Windows
Thumbs.db

docs/superpowers/

# Internal planning documents
docs/superpowers/*
SDLC.md
docs/prototypes/
docs/design/

# Scripts
scripts/sync-task-to-preview.sh
scripts/ship-pr.sh
scripts/release-to-backend.sh

# Stress test reports
tests/stress/reports/

sre/
.superpowers/

# TeamClu system directories
.ac360/

# gstack / codex CLI skills (per-machine tool install, not project config)
.codex/

build.config.json

.opencode/
opencode.json

# White-label icon generation: `tauri icon` emits extra outputs that are NOT in
# tauri.conf.json's bundle.icon list. Branded builds regenerate them; keep them
# out of git so a branded build's working tree stays clean.
apps/desktop/icons/64x64.png
apps/desktop/icons/icon.png
apps/desktop/icons/StoreLogo.png
apps/desktop/icons/Square*Logo.png
apps/desktop/icons/android/
apps/desktop/icons/ios/

# OEM brand assets — kept local to the build machine, never in the shared repo.
# Brand owners supply branding/<brand>/{logo.png,theme.json} + build.config.<brand>.json
# locally; the white-label build reads them from disk at build time.
/branding/
# Chrome Web Store listing kit, assembled from branding/extension/ at release
# time and attached to the Release — a build output, not a source.
/listing-kit/
/listing-kit.zip
/extension.zip
# Ignore all root build.config.<brand>.json except the in-repo flavors.
/build.config.*.json
!/build.config.example.json
!/build.config.production.json
!/build.config.teal.json

server.info
# Tool scratch output. Nothing here is source, and nobody reviews it before
# committing — which is exactly how a bare `git add -A` swept a private
# individual's CV out of .playwright-mcp/ into main once. Same failure mode
# applies to every directory a tool writes into unattended.
.playwright-mcp/
test-results/
playwright-report/
screenshots/
tmp/
log/
